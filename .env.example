# App Environment
APP_NAME=Smart Recruitment Platform – AI-Powered
APP_VERSION=2.0.0
DEBUG=false
SECRET_KEY=change-me-in-production-super-secret-key-32chars

# LLM Configuration (choose one)
# Option 1: Groq (free, fast)
LLM_PROVIDER=groq
LLM_MODEL=llama3-70b-8192
GROQ_API_KEY=your-groq-api-key-here

# Option 2: OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4-turbo-preview
# OPENAI_API_KEY=your-openai-api-key-here

# MongoDB (leave as-is for local dev, in-memory fallback will be used)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=hr_platform

# SQLite (default, zero config)
USE_SQLITE=true
SQLITE_PATH=./hr_local.db

# MySQL (optional, only if USE_SQLITE=false)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=hr_user
MYSQL_PASSWORD=hr_password
MYSQL_DB=hr_structured

# Redis / Celery (optional, sync fallback used if unavailable)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CV Processing
CV_UPLOAD_DIR=./uploaded_cvs
MAX_CV_SIZE_MB=10
OCR_ENABLED=true
SPACY_MODEL=en_core_web_sm

# GitHub (optional, for CV GitHub analysis)
GITHUB_TOKEN=your-github-token-here

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ── Langfuse (Observabilité & Tracing IA) ────────────────────────────────────
# Créer un compte sur https://cloud.langfuse.com (gratuit)
# ou auto-héberger : https://langfuse.com/docs/deployment/self-host
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Privacy / RGPD ───────────────────────────────────────────────────────────
DATA_RETENTION_HOURS=72
ANONYMIZE_BEFORE_LLM=true
